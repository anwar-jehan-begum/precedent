# ============================================================
# PRECEDENT — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git (it is in .gitignore).
# ============================================================

# --- Hindsight memory (Person 1) ---
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BANK_ID=precedent-aml
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# --- Groq LLM (Person 2's DecisionEngine) ---
# Get your key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# --- Dataset (optional override) ---
# Default: data/HI-Small/HI-Small_Trans.csv (gitignored)
# DATASET_PATH=data/HI-Small/HI-Small_Trans.csv
